# Copy to .env and fill real values. NEVER commit .env.

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

DATABASE_ID=
KYC_COLLECTION_ID=
USER_COLLECTION_ID=

# KYC auto-approve: leave unset or "false" to always require admin review (default).
# Set to "true" to auto-approve when the in-app liveness score passes AI_LIVENESS_THRESHOLD.
KYC_AUTO_APPROVE=false

# OpenAI — optional, only for the legacy /api/kyc/ai/* endpoints (unused by the app).
# Key stays on the server only — never put it in the Expo app.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional liveness threshold (default: 0.75)
AI_LIVENESS_THRESHOLD=0.75
# Legacy face-match threshold (unused by the app)
AI_FACE_MATCH_THRESHOLD=0.72

# --- Temporary Prepaid Account (TPA) ---------------------------------------
# Shared Appwrite database + collections (must match paystack-backend).
APPWRITE_DATABASE_ID=
APPWRITE_USER_COLLECTION_ID=
APPWRITE_KYC_COLLECTION_ID=
APPWRITE_TXN_COLLECTION_ID=
APPWRITE_BALANCE_COLLECTION_ID=
APPWRITE_NOTIFICATIONS_COLLECTION_ID=
# Collection holding the stored Expo push token (userId + expoPushToken)
USER_PROFILES_COLLECTION=
# Collection created by scripts/setup-schema.mjs
TPA_COLLECTION_ID=

# Same secret as paystack-backend PAYSTACK_SECRET_KEY (shared secret used by
# /api/tpa/credit when TPA_WEBHOOK_SECRET is not set).
PAYSTACK_SECRET_KEY=
# Optional: override the shared secret for the Paystack -> /api/tpa/credit hop.
# If set, it MUST also be set to the same value in paystack-backend.
TPA_WEBHOOK_SECRET=

# Bearer token required by /api/tpa/expire (Vercel cron sends it automatically).
CRON_SECRET=
