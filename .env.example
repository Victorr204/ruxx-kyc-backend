# Copy to .env and fill real values. NEVER commit .env.

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

DATABASE_ID=
KYC_COLLECTION_ID=
USER_COLLECTION_ID=

# KYC auto-approve: leave unset or "false" to always require admin review (default).
# Set to "true" only to allow AI liveness + face-match to auto-approve submissions.
KYC_AUTO_APPROVE=false

# OpenAI (required for cloud face detection / liveness / server AI re-check).
# Key stays on the server only — never put it in the Expo app.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional thresholds (defaults: 0.75 liveness, 0.72 face match)
AI_LIVENESS_THRESHOLD=0.75
AI_FACE_MATCH_THRESHOLD=0.72
