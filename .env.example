# Copy to .env and fill real values. NEVER commit .env.

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

DATABASE_ID=
KYC_COLLECTION_ID=
USER_COLLECTION_ID=

# --- 60-second auto-approval -----------------------------------------------
# Verified identities (NIN confirmed against the ID photo + face match +
# liveness) approve themselves 60 seconds after submission when no admin has
# decided in time. The daily /api/kyc/autoapprove cron authenticates with
# this secret (Vercel sends it as `Bearer <CRON_SECRET>`). REQUIRED for the
# cron to run: without it the endpoint fails closed and only the app's status
# polling applies the approval.
CRON_SECRET=

# --- Facial verification + NIN document read (server-side vision AI) ---------
# Free tiers first: Google Gemini (primary) → Groq (fallback) → OpenAI
# (optional paid). Runs on submit: face match of the live selfie against the
# ID document, and the in-app NIN check (the entered NIN must match what is
# printed on the ID photo). Keys stay on the server only — never put them in
# the Expo app. When NO key is set, submissions skip both checks and go to
# admin review instead of the 60-second auto-approval.
#
# Gemini — free, no credit card: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq — free, no credit card: https://console.groq.com → API Keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Optional paid fallback — only tried when the free providers fail
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional liveness threshold (default: 0.75)
AI_LIVENESS_THRESHOLD=0.75
# Face-match pass threshold (default: 0.72)
AI_FACE_MATCH_THRESHOLD=0.72

# --- Shared Appwrite database + collections (must match paystack-backend) ----
APPWRITE_DATABASE_ID=
APPWRITE_USER_COLLECTION_ID=
APPWRITE_KYC_COLLECTION_ID=
APPWRITE_TXN_COLLECTION_ID=
APPWRITE_BALANCE_COLLECTION_ID=
APPWRITE_NOTIFICATIONS_COLLECTION_ID=
# Collection holding the stored Expo push token (userId + expoPushToken)
USER_PROFILES_COLLECTION=
