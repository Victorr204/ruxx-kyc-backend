# Copy to .env and fill real values. NEVER commit .env.

APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

DATABASE_ID=
KYC_COLLECTION_ID=
USER_COLLECTION_ID=

# --- 60-second auto-approval -----------------------------------------------
# Verified identities (NIN checked with NIMC + face match + liveness) approve
# themselves 60 seconds after submission when no admin has decided in time.
# The every-minute /api/kyc/autoapprove cron authenticates with this secret
# (Vercel sends it as `Bearer <CRON_SECRET>`). REQUIRED for the cron to run:
# without it the endpoint fails closed and only the app's status polling
# applies the approval.
CRON_SECRET=

# --- NIMC NIN validation (Dojah) ---------------------------------------------
# Server-side only — never put these in the Expo app.
# Sandbox: set DOJAH_SANDBOX=true (test NIN 70123456789) or override the base.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_SANDBOX=false
# DOJAH_BASE_URL=https://api.dojah.io

# --- Facial verification (OpenAI vision) --------------------------------------
# Face match of the live selfie against the ID document, run on submit.
# Key stays on the server only — never put it in the Expo app.
# When unset, submissions skip the face match and go to admin review instead
# of the 60-second auto-approval.
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional liveness threshold (default: 0.75)
AI_LIVENESS_THRESHOLD=0.75
# Face-match pass threshold (default: 0.72)
AI_FACE_MATCH_THRESHOLD=0.72

# --- Shared Appwrite database + collections (must match paystack-backend) ----
APPWRITE_DATABASE_ID=
APPWRITE_USER_COLLECTION_ID=
APPWRITE_KYC_COLLECTION_ID=
APPWRITE_TXN_COLLECTION_ID=
APPWRITE_BALANCE_COLLECTION_ID=
APPWRITE_NOTIFICATIONS_COLLECTION_ID=
# Collection holding the stored Expo push token (userId + expoPushToken)
USER_PROFILES_COLLECTION=
